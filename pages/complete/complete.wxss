.center {
  text-align: center;
}

.receipt-mark {
  position: relative;
  width: 164rpx;
  height: 132rpx;
  margin: 54rpx auto 24rpx;
  border: 2rpx solid rgba(54, 92, 115, 0.22);
  border-radius: 18rpx;
  background: #fffdf8;
}

.receipt-line {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 36rpx;
  height: 2rpx;
  background: rgba(54, 92, 115, 0.22);
}

.receipt-line.short {
  top: 60rpx;
  right: 54rpx;
}

.receipt-stamp {
  position: absolute;
  right: 20rpx;
  bottom: 18rpx;
  color: #c97852;
  font-size: 32rpx;
  font-weight: 650;
}

.result-card {
  margin-top: 42rpx;
  padding: 30rpx 0;
  border-top: 1rpx solid rgba(54, 76, 88, 0.1);
  border-bottom: 1rpx solid rgba(54, 76, 88, 0.1);
}

.result-label {
  margin-top: 18rpx;
  color: #7b8588;
  font-size: 24rpx;
}

.result-label:first-child {
  margin-top: 0;
}

.result-main {
  margin-top: 8rpx;
  color: #263640;
  font-size: 34rpx;
  font-weight: 650;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 34rpx;
}

.complete-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 92rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.2;
}

.complete-primary {
  color: #ffffff;
  background: #365c73;
}

.complete-secondary {
  color: #365c73;
  border: 1rpx solid rgba(54, 92, 115, 0.16);
  background: #edf3f0;
}

.complete-ghost {
  color: #365c73;
  border: 1rpx solid rgba(54, 92, 115, 0.22);
  background: rgba(255, 255, 255, 0.78);
}

.share-button {
  padding: 0;
  border: 0;
  margin: 0;
}

.share-button[disabled] {
  color: rgba(54, 92, 115, 0.52);
  border-color: rgba(54, 92, 115, 0.12);
  background: rgba(237, 243, 240, 0.62);
}

.share-button::after {
  border: 0;
}
