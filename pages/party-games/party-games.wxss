.party-book {
  min-height: calc(100vh - 76rpx);
  box-sizing: border-box;
  padding: 44rpx 24rpx 76rpx;
  background: #fffdf8;
}

.party-hero {
  padding: 0 10rpx 28rpx;
}

.party-hero .title {
  margin-top: 8rpx;
}

.party-hero .subtitle {
  max-width: 650rpx;
  margin-top: 12rpx;
  color: #657276;
  font-size: 26rpx;
  line-height: 1.55;
}

.game-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.game-card {
  position: relative;
  min-height: 520rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f4eee6;
  border: 2rpx solid rgba(54, 76, 88, 0.1);
  box-shadow:
    0 18rpx 38rpx rgba(66, 55, 43, 0.1),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
}

.game-card::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  height: 68%;
  background: linear-gradient(180deg, rgba(255, 253, 248, 0.08) 0%, rgba(255, 253, 248, 0.82) 58%, rgba(255, 253, 248, 0.96) 100%);
  content: "";
  pointer-events: none;
}

.tone-coral {
  border-color: rgba(201, 0, 22, 0.18);
}

.tone-sage {
  border-color: rgba(45, 50, 147, 0.16);
}

.tone-gold {
  border-color: rgba(141, 107, 50, 0.2);
}

.tone-coral::after {
  background: linear-gradient(180deg, rgba(255, 248, 246, 0.05) 0%, rgba(255, 248, 246, 0.84) 58%, rgba(255, 248, 246, 0.97) 100%);
}

.tone-sage::after {
  background: linear-gradient(180deg, rgba(251, 252, 247, 0.08) 0%, rgba(251, 252, 247, 0.84) 58%, rgba(251, 252, 247, 0.97) 100%);
}

.tone-gold::after {
  background: linear-gradient(180deg, rgba(255, 250, 240, 0.08) 0%, rgba(255, 250, 240, 0.86) 58%, rgba(255, 250, 240, 0.97) 100%);
}

.game-art {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.38;
}

.game-scrim {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.brand-panel {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 184rpx;
  box-sizing: border-box;
  padding: 28rpx 28rpx 0;
}

.wnrs-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 130rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  color: #ffffff;
  background: #c90016;
  box-shadow:
    0 8rpx 0 rgba(201, 0, 22, 0.08),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.16);
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.hygge-mark {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 130rpx;
  box-sizing: border-box;
  padding: 0 26rpx;
  border: 2rpx solid rgba(43, 55, 145, 0.1);
  background:
    radial-gradient(circle at 10% 14%, #0b7042 0 14rpx, transparent 15rpx),
    radial-gradient(circle at 90% 24%, #d94b31 0 12rpx, transparent 13rpx),
    radial-gradient(circle at 16% 86%, #d94b31 0 8rpx, transparent 9rpx),
    repeating-linear-gradient(135deg, rgba(43, 55, 145, 0.06) 0 3rpx, transparent 3rpx 12rpx),
    rgba(255, 255, 255, 0.7);
  text-align: center;
  box-shadow: 0 8rpx 0 rgba(45, 50, 147, 0.05);
}

.hygge-main {
  color: #2d3293;
  font-size: 76rpx;
  font-weight: 800;
  line-height: 0.95;
}

.hygge-small {
  color: #2d3293;
  font-size: 26rpx;
  letter-spacing: 0;
  line-height: 1.2;
}

.debate-mark {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  height: 130rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  color: #263640;
  background: rgba(255, 255, 255, 0.78);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.15;
  box-shadow: inset 0 0 0 1rpx rgba(54, 76, 88, 0.08);
}

.bolt {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  color: #ffffff;
  background: #8d6b32;
  border-radius: 50%;
  font-size: 42rpx;
}

.game-content {
  position: relative;
  z-index: 3;
  box-sizing: border-box;
  min-height: 336rpx;
  padding: 30rpx 28rpx 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.game-original {
  color: #9a6a4e;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.35;
  text-transform: uppercase;
}

.tone-coral .game-original,
.tone-sage .game-original {
  font-size: 30rpx;
  font-weight: 800;
}

.tone-coral .game-original {
  color: #c90016;
}

.tone-sage .game-original {
  color: #2d3293;
}

.tone-gold .game-original {
  color: #8d6b32;
}

.game-title {
  margin-top: 8rpx;
  color: #263640;
  font-size: 42rpx;
  font-weight: 650;
  line-height: 1.2;
}

.game-desc {
  margin-top: 14rpx;
  color: #425057;
  font-size: 27rpx;
  line-height: 1.58;
}

.game-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.game-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #365c73;
  background: rgba(255, 255, 255, 0.68);
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.2;
}
