.detail-book {
  padding: 0 0 72rpx;
  background: #fffdf8;
}

.result-hero {
  position: relative;
  min-height: 540rpx;
  margin: 0;
  overflow: hidden;
  background: #edf3f0;
}

.result-hero-art {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.result-hero-scrim {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    linear-gradient(180deg, rgba(255, 253, 248, 0.18) 0%, rgba(255, 253, 248, 0.64) 38%, #fffdf8 100%),
    radial-gradient(circle at 42% 74%, rgba(255, 253, 248, 0.98) 0%, rgba(255, 253, 248, 0.76) 44%, rgba(255, 253, 248, 0.26) 100%);
}

.result-hero-content {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  padding: 254rpx 46rpx 36rpx;
}

.result-hero .title {
  max-width: 620rpx;
  margin-top: 8rpx;
  font-size: 54rpx;
  line-height: 1.2;
}

.result-hero .subtitle {
  max-width: 620rpx;
  color: #5f6d72;
  font-size: 28rpx;
  line-height: 1.55;
}

.result-stats {
  display: inline-flex;
  margin-top: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #365c73;
  background: rgba(237, 243, 240, 0.8);
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.25;
}

.share-panel {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin: 18rpx 32rpx 0;
  padding: 0;
}

.share-panel-desc {
  grid-column: 1 / -1;
  margin-bottom: 2rpx;
  color: #6d777b;
  font-size: 24rpx;
  line-height: 1.35;
  white-space: nowrap;
}

.share-result-button,
.image-result-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 94rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.2;
}

.share-result-button {
  color: #ffffff;
  background: #365c73;
}

.share-result-button[disabled] {
  color: rgba(54, 92, 115, 0.72);
  background: #edf3f0;
}

.share-result-button::after {
  border: 0;
}

.image-result-button {
  color: #365c73;
  background: #edf3f0;
}

.save-note {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 2rpx 2rpx 0;
  color: #6d777b;
  font-size: 24rpx;
  line-height: 1.45;
}

.save-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #365c73;
}

.image-ready {
  margin: 18rpx 32rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  color: #365c73;
  background: #edf3f0;
  font-size: 25rpx;
  line-height: 1.5;
}

.record-section-title {
  margin: 36rpx 32rpx 2rpx;
  color: #263640;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.3;
}

.answer-card {
  margin: 18rpx 32rpx 0;
  padding: 28rpx 28rpx 30rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow:
    0 10rpx 28rpx rgba(66, 55, 43, 0.05),
    inset 0 0 0 1rpx rgba(54, 76, 88, 0.08);
}

.answer-q {
  color: #263640;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.5;
}

.answer-line {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 22rpx;
}

.answer-avatar {
  flex: 0 0 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  color: #365c73;
  background: #edf3f0;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1;
}

.answer-avatar.second {
  color: #9a5a39;
  background: #f7e4d9;
}

.answer-bubble {
  flex: 1;
  min-width: 0;
  padding: 2rpx 0 18rpx;
  border-bottom: 1rpx solid rgba(54, 76, 88, 0.08);
}

.answer-text {
  color: #4f5d62;
  font-size: 27rpx;
  line-height: 1.58;
}

.record-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  pointer-events: none;
}
