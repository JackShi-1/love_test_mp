.mine-book {
  padding: 0 0 76rpx;
  background: #fffdf8;
}

.archive-hero {
  padding: 48rpx 40rpx 24rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 2rpx 32rpx 0;
  padding: 24rpx 0 24rpx;
  border-bottom: 1rpx solid rgba(54, 76, 88, 0.11);
  background: transparent;
}

.profile-label {
  color: #9a6a4e;
  font-size: 22rpx;
  font-weight: 650;
}

.profile-name {
  margin-top: 6rpx;
  color: #263640;
  font-size: 32rpx;
  font-weight: 650;
}

.profile-action {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #9a5a39;
  background: #fbede3;
  font-size: 24rpx;
  font-weight: 650;
}

.quick-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  margin: 0 32rpx;
  border-bottom: 1rpx solid rgba(54, 76, 88, 0.11);
}

.quick-card {
  padding: 28rpx 20rpx;
  border-radius: 0;
  color: #365c73;
  background: transparent;
  font-size: 28rpx;
  font-weight: 650;
  text-align: center;
}

.quick-card + .quick-card {
  border-left: 1rpx solid rgba(54, 76, 88, 0.11);
}

.records-title {
  margin: 44rpx 32rpx 0;
}

.empty-card,
.loading-card,
.record-card {
  margin: 18rpx 32rpx 0;
  padding: 28rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow:
    0 10rpx 28rpx rgba(66, 55, 43, 0.05),
    inset 0 0 0 1rpx rgba(54, 76, 88, 0.08);
}

.empty-card {
  margin: 18rpx 32rpx 0;
  color: #6d777b;
  font-size: 26rpx;
  line-height: 1.5;
}

.loading-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: #6d777b;
  font-size: 26rpx;
  line-height: 1.5;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(54, 76, 88, 0.14);
  border-top-color: #c97852;
  border-radius: 50%;
  animation: loadingSpin 760ms linear infinite;
}

@keyframes loadingSpin {
  100% {
    transform: rotate(360deg);
  }
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.record-main {
  flex: 1;
  min-width: 0;
  color: #263640;
  font-size: 32rpx;
  font-weight: 650;
}

.record-delete {
  position: relative;
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #fbede3;
}

.trash-icon {
  position: absolute;
  left: 18rpx;
  top: 20rpx;
  width: 22rpx;
  height: 24rpx;
  box-sizing: border-box;
  border: 3rpx solid #9a5a39;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
}

.trash-icon::before {
  position: absolute;
  left: -4rpx;
  top: -8rpx;
  width: 30rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #9a5a39;
  content: "";
}

.trash-icon::after {
  position: absolute;
  left: 6rpx;
  top: -13rpx;
  width: 10rpx;
  height: 5rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: #9a5a39;
  content: "";
}

.record-meta {
  margin-top: 10rpx;
  color: #7b8588;
  font-size: 26rpx;
}

.record-mode {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #9a5a39;
  background: #fbede3;
  font-size: 24rpx;
}

.edit-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  display: flex;
  align-items: flex-end;
  background: rgba(38, 54, 64, 0.34);
}

.edit-dialog {
  width: 100%;
  box-sizing: border-box;
  padding: 18rpx 28rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 26rpx 26rpx 0 0;
  background: #fffdf8;
  box-shadow: 0 -18rpx 42rpx rgba(38, 54, 64, 0.14);
}

.dialog-grip {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: rgba(54, 76, 88, 0.18);
}

.edit-title {
  color: #263640;
  font-size: 32rpx;
  font-weight: 650;
}

.edit-input {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(54, 76, 88, 0.12);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #263640;
  font-size: 30rpx;
}

.edit-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.edit-button {
  flex: 1;
  min-height: 82rpx;
}
