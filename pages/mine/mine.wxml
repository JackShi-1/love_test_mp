<view class="page mine-page safe-bottom">
  <view class="book-page mine-book">
    <view class="archive-hero">
      <view class="kicker">ARCHIVE</view>
      <view class="title">我的记录</view>
      <view class="subtitle">这里保存你完成过的对话，也像一本可以翻回去看的旧页。</view>
    </view>

    <view class="profile-card" bindtap="loginWithWechat">
      <view>
        <view class="profile-label">当前昵称</view>
        <view class="profile-name">{{userNickName || '未设置昵称'}}</view>
      </view>
      <view class="profile-action">{{userNickName ? '更换' : '设置'}}</view>
    </view>

    <view class="quick-list">
      <view class="quick-card" bindtap="goGuide">使用说明</view>
      <view class="quick-card" bindtap="goAbout">关于我们</view>
    </view>

    <view class="section-title records-title">历史记录</view>
    <view wx:if="{{records.length === 0}}" class="empty-card">
      <view>还没有完成的对话记录。</view>
    </view>

    <view wx:for="{{records}}" wx:key="id" class="record-card" data-id="{{item._id || item.id}}" data-local="{{!item._id && item.mode === 'same-device'}}" bindtap="openRecord">
      <view class="record-main">{{item.versionTitle}}</view>
      <view class="record-meta">{{item.dateText}} · {{item.durationText}}</view>
      <view class="record-mode">{{item.mode === 'invite' ? '双机同步答' : '面对面同屏'}}</view>
    </view>
    <view class="page-number">A</view>
  </view>
</view>
