.home {
  background: #f7f5f0;
}

.cover-page {
  display: flex;
  flex-direction: column;
  padding: 0 0 34rpx;
  background: #fffdf8;
}

.cover-page::before,
.cover-page::after {
  display: none;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 12rpx 32rpx 16rpx;
}

.home .title {
  font-size: 44rpx;
  line-height: 1.15;
}

.home .subtitle {
  max-width: 650rpx;
  margin-top: 10rpx;
  color: #657276;
  font-size: 24rpx;
  line-height: 1.45;
}

.hero-art-wrap {
  position: relative;
  height: 230rpx;
  overflow: hidden;
  background: #efe5d6;
}

.hero-art-wrap::after {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 90rpx;
  background: linear-gradient(180deg, rgba(255, 253, 248, 0) 0%, #fffdf8 100%);
  content: "";
}

.hero-art {
  width: 100%;
  height: 100%;
}

.type-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 22rpx;
}

.type-card {
  position: relative;
  min-height: 460rpx;
  padding: 18rpx 26rpx 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fffaf2;
  box-shadow:
    0 12rpx 28rpx rgba(66, 55, 43, 0.07),
    inset 0 0 0 1rpx rgba(54, 76, 88, 0.06);
}

.type-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.type-scrim {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    linear-gradient(
      180deg,
      rgba(255, 253, 248, 0) 0%,
      rgba(255, 253, 248, 0.1) 38%,
      rgba(255, 253, 248, 0.88) 100%
    ),
    linear-gradient(
      90deg,
      rgba(255, 253, 248, 0.03) 0%,
      rgba(255, 253, 248, 0.68) 76%,
      rgba(255, 253, 248, 0.5) 100%
    );
}

.type-content {
  position: relative;
  z-index: 2;
  padding-top: 178rpx;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.72);
}

.relationship-card {
  background: #f8eee6;
}

.aron-card {
  background: #edf3f0;
}

.relationship-card .type-scrim {
  background:
    linear-gradient(
      180deg,
      rgba(255, 250, 244, 0) 0%,
      rgba(255, 249, 243, 0.1) 38%,
      rgba(255, 249, 243, 0.9) 100%
    ),
    linear-gradient(
      90deg,
      rgba(255, 249, 243, 0.04) 0%,
      rgba(255, 249, 243, 0.72) 76%,
      rgba(255, 249, 243, 0.5) 100%
    );
}

.aron-card .type-scrim {
  background:
    linear-gradient(
      180deg,
      rgba(249, 253, 249, 0) 0%,
      rgba(249, 253, 249, 0.1) 38%,
      rgba(249, 253, 249, 0.88) 100%
    ),
    linear-gradient(
      90deg,
      rgba(249, 253, 249, 0.03) 0%,
      rgba(249, 253, 249, 0.68) 76%,
      rgba(249, 253, 249, 0.5) 100%
    );
}

.type-eyebrow {
  color: #9a6a4e;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.45;
}

.aron-card .type-eyebrow {
  color: #56758a;
}

.type-summary {
  margin-top: 8rpx;
  color: #344750;
  font-size: 28rpx;
  line-height: 1.58;
}

.type-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.type-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #365c73;
  background: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
  line-height: 1.25;
}

.relationship-card .type-tag {
  color: #9a5a39;
}

.type-desc {
  margin-top: 14rpx;
  color: #5b666b;
  font-size: 24rpx;
  line-height: 1.52;
}

.home-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: auto;
  padding: 22rpx 0 4rpx;
  color: #365c73;
  font-size: 25rpx;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #c9c5bc;
}

.profile-mask {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 30rpx calc(env(safe-area-inset-bottom) + 34rpx);
  background: rgba(38, 54, 64, 0.18);
}

.profile-dialog {
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx 30rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 253, 248, 0.98);
  box-shadow:
    0 20rpx 54rpx rgba(38, 54, 64, 0.16),
    inset 0 0 0 1rpx rgba(54, 76, 88, 0.08);
}

.profile-dialog-title {
  color: #263640;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.28;
}

.profile-dialog-desc {
  margin-top: 12rpx;
  color: #6d777b;
  font-size: 25rpx;
  line-height: 1.55;
}

.profile-dialog-actions {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 16rpx;
  margin-top: 26rpx;
}

.profile-skip,
.profile-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.2;
}

.profile-skip {
  color: #365c73;
  background: #edf3f0;
}

.profile-confirm {
  color: #ffffff;
  background: #365c73;
}
