.guide-book {
  padding: 0 0 76rpx;
  background: #fffdf8;
}

.guide-hero {
  padding: 48rpx 40rpx 20rpx;
}

.guide-card {
  margin: 18rpx 32rpx 0;
  padding: 28rpx 0 26rpx;
  border-bottom: 1rpx solid rgba(54, 76, 88, 0.11);
}

.guide-title {
  color: #263640;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.35;
}

.guide-text {
  margin-top: 14rpx;
  color: #4f5d62;
  font-size: 27rpx;
  line-height: 1.68;
}

.version-card {
  position: relative;
  margin: 20rpx 32rpx 0;
  padding: 30rpx 30rpx 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #edf3f0;
}

.version-card::after {
  position: absolute;
  right: -40rpx;
  bottom: -58rpx;
  width: 180rpx;
  height: 180rpx;
  border: 2rpx solid rgba(54, 92, 115, 0.08);
  border-radius: 50%;
  content: "";
}

.version-card.goodbye {
  background: #fbede3;
}

.version-label {
  color: #9a6a4e;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.3;
}

.version-card.aron .version-label {
  color: #56758a;
}

.version-title {
  margin-top: 10rpx;
  color: #263640;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.28;
}
