.play-book {
  position: relative;
  min-height: calc(100vh - 76rpx);
  box-sizing: border-box;
  padding: 32rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #fffdf8;
}

.tone-coral .play-book {
  background: #fff8f6;
}

.tone-sage .play-book {
  background: #fbfcf7;
}

.tone-gold .play-book {
  background: #fffaf0;
}

.play-bg {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  width: 100%;
  height: 620rpx;
  opacity: 0.72;
  filter: blur(1rpx);
}

.play-bg-scrim {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 720rpx;
  background:
    linear-gradient(180deg, rgba(255, 253, 248, 0.08) 0%, rgba(255, 253, 248, 0.5) 48%, #fffdf8 100%),
    radial-gradient(circle at 50% 12%, rgba(255, 255, 255, 0), rgba(255, 253, 248, 0.64) 72%);
}

.tone-coral .play-bg-scrim {
  background:
    linear-gradient(180deg, rgba(255, 248, 246, 0.02) 0%, rgba(255, 248, 246, 0.48) 48%, #fff8f6 100%),
    linear-gradient(90deg, rgba(201, 0, 22, 0.06), rgba(255, 248, 246, 0.42));
}

.tone-sage .play-bg-scrim {
  background:
    linear-gradient(180deg, rgba(251, 252, 247, 0.05) 0%, rgba(251, 252, 247, 0.52) 48%, #fbfcf7 100%),
    radial-gradient(circle at 18% 12%, rgba(11, 112, 66, 0.08), transparent 36%),
    radial-gradient(circle at 84% 18%, rgba(217, 75, 49, 0.08), transparent 34%);
}

.tone-gold .play-bg-scrim {
  background:
    linear-gradient(180deg, rgba(255, 250, 240, 0.04) 0%, rgba(255, 250, 240, 0.56) 48%, #fffaf0 100%),
    radial-gradient(circle at 50% 12%, rgba(141, 107, 50, 0.1), transparent 42%);
}

.play-head,
.deck-wrap,
.draw-button {
  position: relative;
  z-index: 2;
}

.play-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.play-title {
  margin-top: 8rpx;
  color: #263640;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.08;
  text-transform: uppercase;
}

.tone-coral .play-title {
  display: inline-flex;
  max-width: 650rpx;
  padding: 22rpx 24rpx;
  color: #ffffff;
  background: #c90016;
  font-size: 30rpx;
  line-height: 1.15;
  box-shadow: 10rpx 10rpx 0 rgba(201, 0, 22, 0.1);
}

.tone-sage .play-title {
  color: #2d3293;
  font-size: 58rpx;
  letter-spacing: 0;
}

.tone-gold .play-title {
  color: #263640;
  font-size: 42rpx;
}

.play-subtitle {
  margin-top: 12rpx;
  color: #5f6d72;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.25;
}

.tone-coral .play-subtitle {
  color: #9a5a39;
}

.tone-sage .play-subtitle {
  color: #567064;
}

.tone-gold .play-subtitle {
  color: #8d6b32;
}

.deck-wrap {
  position: relative;
  margin-top: 42rpx;
  min-height: calc(100vh - 360rpx);
}

.deck-shadow,
.question-card {
  position: absolute;
  right: 4rpx;
  left: 4rpx;
  border-radius: 34rpx;
}

.deck-shadow {
  height: calc(100vh - 390rpx);
  min-height: 760rpx;
  background: rgba(255, 255, 255, 0.5);
  box-shadow: inset 0 0 0 1rpx rgba(54, 76, 88, 0.07);
}

.deck-shadow.one {
  top: 42rpx;
  transform: rotate(-4deg);
}

.deck-shadow.two {
  top: 28rpx;
  transform: rotate(3deg);
}

.deck-shadow.three {
  top: 16rpx;
  transform: rotate(-1deg);
}

.draw-pile {
  position: absolute;
  top: -28rpx;
  right: 20rpx;
  z-index: 4;
  width: 126rpx;
  height: 92rpx;
  pointer-events: none;
}

.pile-card {
  position: absolute;
  width: 88rpx;
  height: 66rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow:
    0 8rpx 18rpx rgba(38, 54, 64, 0.08),
    inset 0 0 0 1rpx rgba(54, 76, 88, 0.08);
}

.tone-coral .pile-card {
  background:
    linear-gradient(90deg, #c90016 0 20rpx, #ffffff 20rpx),
    #ffffff;
  box-shadow:
    0 8rpx 18rpx rgba(154, 0, 19, 0.12),
    inset 0 0 0 2rpx rgba(201, 0, 22, 0.32);
}

.tone-sage .pile-card {
  background:
    repeating-linear-gradient(135deg, rgba(45, 50, 147, 0.08) 0 3rpx, transparent 3rpx 12rpx),
    #ffffff;
}

.tone-gold .pile-card {
  background:
    linear-gradient(135deg, transparent 0 42%, rgba(141, 107, 50, 0.85) 42% 48%, transparent 48%),
    #263640;
}

.pile-one {
  right: 0;
  top: 18rpx;
  transform: rotate(8deg);
}

.pile-two {
  right: 18rpx;
  top: 10rpx;
  transform: rotate(-7deg);
}

.pile-three {
  right: 36rpx;
  top: 0;
  transform: rotate(3deg);
}

.question-card {
  top: 0;
  min-height: calc(100vh - 360rpx);
  box-sizing: border-box;
  padding: 0 38rpx 54rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #fffdf8;
  box-shadow:
    0 24rpx 60rpx rgba(38, 54, 64, 0.13),
    inset 0 0 0 1rpx rgba(54, 76, 88, 0.08);
  transform-origin: 84% 6%;
}

.question-card::before {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 16rpx;
  background: rgba(54, 76, 88, 0.05);
  content: "";
}

.tone-coral .question-card {
  background:
    linear-gradient(90deg, #c90016 0 18rpx, transparent 18rpx),
    linear-gradient(180deg, #ffffff 0 88rpx, transparent 88rpx),
    linear-gradient(180deg, rgba(201, 0, 22, 0.035), rgba(255, 255, 255, 0) 34%),
    #ffffff;
  box-shadow:
    0 28rpx 66rpx rgba(154, 0, 19, 0.16),
    inset 0 0 0 2rpx rgba(201, 0, 22, 0.22);
}

.tone-sage .question-card {
  background:
    linear-gradient(90deg, rgba(45, 50, 147, 0.95) 0 12rpx, transparent 12rpx),
    radial-gradient(circle at 12% 20%, #0b7042 0 10rpx, transparent 11rpx),
    radial-gradient(circle at 86% 12%, #d94b31 0 9rpx, transparent 10rpx),
    radial-gradient(circle at 92% 88%, #0b7042 0 12rpx, transparent 13rpx),
    repeating-linear-gradient(135deg, rgba(45, 50, 147, 0.045) 0 3rpx, transparent 3rpx 13rpx),
    #ffffff;
  box-shadow:
    0 28rpx 66rpx rgba(45, 50, 147, 0.12),
    inset 0 0 0 2rpx rgba(45, 50, 147, 0.12);
}

.tone-gold .question-card {
  background:
    linear-gradient(135deg, transparent 0 58%, rgba(141, 107, 50, 0.16) 58% 60%, transparent 60%),
    radial-gradient(circle at 12% 16%, rgba(141, 107, 50, 0.14), transparent 18%),
    linear-gradient(135deg, rgba(38, 54, 64, 0.05), rgba(255, 255, 255, 0) 36%),
    #ffffff;
  box-shadow:
    0 28rpx 66rpx rgba(141, 107, 50, 0.13),
    inset 0 0 0 2rpx rgba(141, 107, 50, 0.14);
}

.brand-strip {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 0 -38rpx;
  padding: 22rpx 32rpx;
  color: #ffffff;
  background: #365c73;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
}

.tone-coral .brand-strip {
  margin-left: -20rpx;
  border-bottom: 2rpx solid rgba(201, 0, 22, 0.18);
  color: #c90016;
  background: #ffffff;
  font-size: 24rpx;
}

.tone-sage .brand-strip {
  color: #2d3293;
  background:
    repeating-linear-gradient(135deg, rgba(45, 50, 147, 0.08) 0 3rpx, transparent 3rpx 12rpx),
    #ffffff;
  box-shadow: inset 0 -1rpx 0 rgba(45, 50, 147, 0.14);
}

.tone-gold .brand-strip {
  color: #f7ead0;
  background:
    linear-gradient(135deg, rgba(141, 107, 50, 0.22), transparent 44%),
    #263640;
}

.strip-dot {
  flex: 0 0 auto;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.68;
}

.question-body {
  position: relative;
  z-index: 1;
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  box-sizing: border-box;
  min-height: 0;
  padding: 0 0 78rpx;
}

.motion-in {
  animation: cardRise 520ms cubic-bezier(0.18, 0.82, 0.22, 1) both;
}

.motion-next {
  animation: cardDraw 640ms cubic-bezier(0.18, 0.82, 0.22, 1) both;
}

@keyframes cardRise {
  0% {
    opacity: 0;
    transform: translateY(80rpx) scale(0.94) rotate(-3deg);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1) rotate(0);
  }
}

@keyframes cardDraw {
  0% {
    opacity: 0;
    transform: translate(170rpx, -130rpx) rotate(14deg) scale(0.42);
  }
  45% {
    opacity: 1;
    transform: translate(-18rpx, 12rpx) rotate(-3deg) scale(1.02);
  }
  100% {
    opacity: 1;
    transform: translate(0, 0) rotate(0) scale(1);
  }
}

.question-meta {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  margin-top: 46rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #9a6a4e;
  background: #fbede3;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.35;
}

.tone-sage .question-meta {
  color: #2d3293;
  background: rgba(45, 50, 147, 0.08);
}

.tone-gold .question-meta {
  color: #8d6b32;
  background: #f4ecd7;
}

.question-english {
  width: 100%;
  margin-top: 0;
  color: #263640;
  font-size: 62rpx;
  font-weight: 650;
  line-height: 1.12;
  word-break: break-word;
}

.tone-coral .question-english {
  color: #202b31;
  font-weight: 760;
}

.tone-sage .question-english {
  color: #2d3293;
  font-weight: 760;
}

.tone-gold .question-english {
  color: #263640;
}

.question-chinese {
  width: 100%;
  margin-top: 30rpx;
  color: #5f6d72;
  font-size: 25rpx;
  line-height: 1.5;
}

.draw-button {
  position: fixed;
  right: 42rpx;
  bottom: calc(42rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  min-height: 62rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #365c73;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.2;
  box-shadow: 0 14rpx 32rpx rgba(54, 92, 115, 0.22);
}

.tone-coral .draw-button {
  background: #c90016;
  box-shadow: 0 14rpx 28rpx rgba(154, 0, 19, 0.18);
}

.tone-sage .draw-button {
  color: #ffffff;
  background: #2d3293;
  box-shadow: 0 14rpx 28rpx rgba(45, 50, 147, 0.18);
}

.tone-gold .draw-button {
  background: #8d6b32;
  box-shadow: 0 14rpx 28rpx rgba(141, 107, 50, 0.17);
}
